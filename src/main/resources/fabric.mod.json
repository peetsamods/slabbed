{
  "schemaVersion": 1,
  "id": "slabbed",
  "version": "${version}",
  "name": "Slabbed",
  "icon": "assets/slabbed/icon.png",
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.slabbed.Slabbed"
    ],
    "client": [
      "com.slabbed.client.SlabbedClient"
    ],
    "modmenu": [
      "com.slabbed.client.SlabbedModMenu"
    ]
  },
  "mixins": [
    {
      "config": "slabbed.relativeblocks.mixins.json"
    },
    {
      "config": "slabbed.mixins.json"
    },
    {
      "config": "slabbed.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "slabbed.offgrid.mixins.json"
    },
    {
      "environment": "client",
      "config": "slabbed.fwa.mixins.json"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": ">=0.152.2",
    "minecraft": [
      "26.2",
      "26.3"
    ]
  }
}
