#!/usr/bin/env bash
# Slabbed guardrails (S-1/S-4/S-5/S-6). Enforced at commit time.
# Install once per checkout:  git config core.hooksPath tools/hooks
# Bypass in a genuine emergency:  git commit --no-verify   (logged in your reflog; use sparingly)
#
# S-2 (NeighborUpdateInvarianceTest) is the LAW 1 gate and is BLOCKING BY DEFAULT since
# 2026-08-06 — the executable test enforces the law; this hook only guards process hygiene.
# S-3 (the added-line vocabulary regex) was RETIRED 2026-08-07 by maintainer ruling: with S-2
# blocking, a keyword tripwire that fires on comments was redundant belt-on-suspenders.
set -euo pipefail
MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"
STAGED="$(git diff --cached --name-only)"
fail() { echo ""; echo "  ✗ LAW GUARDRAIL: $1"; echo ""; exit 1; }

# ── S-1: no doc may mention the law without deferring to LAW.md ──────────────────────────────
# Any staged *.md (except LAW.md itself) that uses the law vocabulary must contain the string
# "LAW.md" (a back-reference), so no doc can quietly redefine the law again (post-mortem F-4).
for f in $STAGED; do
  case "$f" in
    LAW.md) continue ;;
    *.md)
      [ -f "$f" ] || continue
      if grep -qiE 'wysiwyg|never.?pop|\bfreeze' "$f" && ! grep -q 'LAW.md' "$f"; then
        fail "S-1: '$f' discusses the law (WYSIWYG/never-pop/freeze) but does not reference LAW.md.
       Add a line: 'See LAW.md — this doc does not redefine the law.' LAW.md is supreme."
      fi
      ;;
  esac
done

# ── Behavior-touching change? (the height engine + placement path) ───────────────────────────
BEHAVIOR="$(echo "$STAGED" | grep -E 'src/main/.*(SlabSupport|SlabAnchorAttachment|PlacementIntent|OnPlacedAnchor|OnStateReplaced|OffsetRaycast)' || true)"
SRC_MAIN="$(echo "$STAGED" | grep -E '^src/main/' || true)"

# ── S-4: preflight trailer required for any src/main change ──────────────────────────────────
if [ -n "$SRC_MAIN" ]; then
  if ! echo "$MSG" | grep -qE '^LAW-PREFLIGHT: (n|y)'; then
    fail "S-4: this commit changes src/main/** — add a trailer answering the law preflight:
         LAW-PREFLIGHT: n     (this change does NOT let a neighbor move a placed block)
       or, if it might:
         LAW-PREFLIGHT: y     (+ record the maintainer sign-off in the body). See LAW.md."
  fi
fi

# ── S-5: no more than one behavior change may stack without a live pass ──────────────────────
# The live ledger lives OUTSIDE the repo (discretion law, 2026-08-07), by default at
#   $HOME/CascadeProjects/Slabbed-notes/parity-1.20.1/LIVE_LEDGER.md   (override: $SLABBED_NOTES)
# A behavior-touching commit is allowed only if the ledger has been updated since the previous
# behavior-touching commit (ledger mtime vs that commit's time) — same rule as before, the
# bookkeeping just moved out of the tracked tree.
if [ -n "$BEHAVIOR" ]; then
  NOTES_DIR="${SLABBED_NOTES:-$HOME/CascadeProjects/Slabbed-notes/parity-1.20.1}"
  LEDGER_FILE="$NOTES_DIR/LIVE_LEDGER.md"
  if [ ! -f "$LEDGER_FILE" ]; then
    fail "S-5: local ledger not found at $LEDGER_FILE.
       Behavior-touching commits require the out-of-repo live ledger. Create the notes directory
       (or set \$SLABBED_NOTES) and record the live state there before committing behavior changes."
  fi
  LAST_BEHAVIOR_TS="$(git log -1 --format=%ct -- \
      'src/main/**/SlabSupport.java' 'src/main/**/SlabAnchorAttachment.java' \
      'src/main/**/*PlacementIntent*' 'src/main/**/*OnPlacedAnchor*' \
      'src/main/**/*OnStateReplaced*' 'src/main/**/*OffsetRaycast*' 2>/dev/null || true)"
  LEDGER_TS="$(stat -f %m "$LEDGER_FILE" 2>/dev/null || stat -c %Y "$LEDGER_FILE" 2>/dev/null || echo 0)"
  if [ -n "$LAST_BEHAVIOR_TS" ] && [ "$LAST_BEHAVIOR_TS" -gt "$LEDGER_TS" ]; then
    fail "S-5: a behavior-changing commit already landed since the ledger was last updated, and this
       is another one without a recorded live result. Do NOT stack. Get a live A/B first, record it
       in $LEDGER_FILE (dated, jar-sha'd, 'live-confirmed' or 'live-RED'), then commit.
       The 12-tranche sight-unseen campaign is exactly what this stops."
  fi
fi

# ── S-6: discretion gate — the public repo carries no personal or machine-local data ─────────
# Maintainer ruling 2026-08-07: no personal names, no local absolute paths, no development-diary
# identifiers in any ADDED line of any tracked file. Process notes live OUTSIDE the repo.
# The owner policy lives outside the repository. This also works when this hook
# is installed directly, without the dispatcher that normally runs pre-commit.
scanner="$(git config --global --path --get repoSafety.scanner)" || fail "S-6: privacy scanner is not configured."
patterns="$(git config --global --path --get repoSafety.patterns)" || fail "S-6: private match rules are not configured."
python3 "$scanner" --patterns "$patterns" staged || fail "S-6: the staged privacy check failed."

# Keep the bare macOS home prefix covered even when there is no username after it.
home_prefix='/Users''/'
if git diff --cached --no-ext-diff --unified=0 | awk -v prefix="$home_prefix" '
  /^\+/ && !/^\+\+\+ / && index($0, prefix) { found = 1 }
  END { exit !found }
'; then
  fail "S-6: an added line contains an absolute home-directory prefix."
fi

exit 0
