#!/usr/bin/env bash
# Slabbed guardrails (S-1/S-4/S-5/S-6). Enforced at commit time.
# Install once per checkout:  git config core.hooksPath tools/hooks
# Bypass in a genuine emergency:  git commit --no-verify   (logged in your reflog; use sparingly)
#
# S-2 (NeighborUpdateInvarianceTest) is the LAW 1 gate and is BLOCKING BY DEFAULT since
# 2026-08-06 — the executable test enforces the law; this hook only guards process hygiene.
# S-3 (the added-line vocabulary regex) was RETIRED 2026-08-07 by maintainer ruling: with S-2
# blocking, a keyword tripwire that fires on comments was redundant belt-on-suspenders.
set -euo pipefail
MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"
STAGED="$(git diff --cached --name-only)"
fail() { echo ""; echo "  ✗ LAW GUARDRAIL: $1"; echo ""; exit 1; }

# ── S-1: no doc may mention the law without deferring to LAW.md ──────────────────────────────
# Any staged *.md (except LAW.md itself) that uses the law vocabulary must contain the string
# "LAW.md" (a back-reference), so no doc can quietly redefine the law again (post-mortem F-4).
for f in $STAGED; do
  case "$f" in
    LAW.md) continue ;;
    *.md)
      [ -f "$f" ] || continue
      if grep -qiE 'wysiwyg|never.?pop|\bfreeze' "$f" && ! grep -q 'LAW.md' "$f"; then
        fail "S-1: '$f' discusses the law (WYSIWYG/never-pop/freeze) but does not reference LAW.md.
       Add a line: 'See LAW.md — this doc does not redefine the law.' LAW.md is supreme."
      fi
      ;;
  esac
done

# ── Behavior-touching change? (the height engine + placement path) ───────────────────────────
BEHAVIOR="$(echo "$STAGED" | grep -E 'src/main/.*(SlabSupport|SlabAnchorAttachment|PlacementIntent|OnPlacedAnchor|OnStateReplaced|OffsetRaycast)' || true)"
SRC_MAIN="$(echo "$STAGED" | grep -E '^src/main/' || true)"

# ── S-4: preflight trailer required for any src/main change ──────────────────────────────────
if [ -n "$SRC_MAIN" ]; then
  if ! echo "$MSG" | grep -qE '^LAW-PREFLIGHT: (n|y)'; then
    fail "S-4: this commit changes src/main/** — add a trailer answering the law preflight:
         LAW-PREFLIGHT: n     (this change does NOT let a neighbor move a placed block)
       or, if it might:
         LAW-PREFLIGHT: y     (+ record the maintainer sign-off in the body). See LAW.md."
  fi
fi

# ── S-5: no more than one behavior change may stack without a live pass ──────────────────────
# Count behavior-touching commits since LIVE_LEDGER.md last gained an entry; block the 2nd.
if [ -n "$BEHAVIOR" ]; then
  LEDGER_COMMIT="$(git log -1 --format=%H -- docs/process/LIVE_LEDGER.md 2>/dev/null || true)"
  RANGE="${LEDGER_COMMIT:+$LEDGER_COMMIT..HEAD}"
  BEHAVIOR_SINCE="$(git log ${RANGE:-} --format=%H -- \
      'src/main/**/SlabSupport.java' 'src/main/**/SlabAnchorAttachment.java' \
      'src/main/**/*PlacementIntent*' 'src/main/**/*OnPlacedAnchor*' \
      'src/main/**/*OnStateReplaced*' 'src/main/**/*OffsetRaycast*' 2>/dev/null | wc -l | tr -d ' ')"
  LEDGER_STAGED="$(echo "$STAGED" | grep -c 'docs/process/LIVE_LEDGER.md' || true)"
  if [ "${BEHAVIOR_SINCE:-0}" -ge 1 ] && [ "${LEDGER_STAGED:-0}" -eq 0 ]; then
    fail "S-5: a behavior-changing commit already landed since the last live pass, and this is another
       one without a recorded live result. Do NOT stack. Get a live A/B first, record it in
       docs/process/LIVE_LEDGER.md (dated, jar-sha'd, 'live-confirmed' or 'live-RED'), and stage that
       ledger entry with this commit. The 12-tranche sight-unseen campaign is exactly what this stops."
  fi
fi

# ── S-6: discretion gate — the public repo carries no personal or machine-local data ─────────
# Maintainer ruling 2026-08-07: no personal names, no local absolute paths, no development-diary
# identifiers in any ADDED line of any tracked file. Process notes live OUTSIDE the repo.
# Pattern assembled from pieces so this hook's own diff can never match itself.
DISCRETION_PAT="Ju""lia|jool""mac|/Use""rs/"
DISCRETION_HITS="$(git diff --cached --unified=0 \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -E "$DISCRETION_PAT" || true)"
if [ -n "$DISCRETION_HITS" ]; then
  fail "S-6: added lines contain personal or machine-local data (a personal name, a local
       username, or an absolute home-directory path). The public repo stays impersonal — move
       narrative to the local notes ledger and reference rulings as 'maintainer ruling, <date>'.
       Offending lines:
$(echo "$DISCRETION_HITS" | sed 's/^/         /' | head -12)"
fi

exit 0
